      ],
      "id": "d587f2c5-30ba-4aa6-82e3-d4ce9c63caae",
      "name": "Code2"
    },
    {
      "parameters": {
        "jsCode": "const skills = $input.first().json.skills;\nconst counts = {};\n\ncounts[\"num_of_vacancies\"] = $input.first().json.num_of_vacancies\nfor (const skill of skills) {\n  counts[skill] = (counts[skill] || 0) + 1;\n}\n\nreturn [{ json: { counts } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
