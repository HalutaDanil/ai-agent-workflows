    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst skills = [];\nlet numOfVacancies = 0;\n\nfor (const it of items) {\n  const out = it.json.output;\n  numOfVacancies += 1\n  skills.push(...out.split(\",\"))\n}\n\nreturn [\n  {\n    json: {\n      num_of_vacancies: numOfVacancies,\n      skills: skills\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
