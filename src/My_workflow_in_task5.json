    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\n\nif (!data.chatHistory) {\n  data.chatHistory = [];\n}\n\ndata.chatHistory.push({\n  role: 'user',\n  content: $input.first().json.message.text,\n});\n\nconst itemOut = {\n  json: { \n    chatHistory: data.chatHistory,  \n  },\n};\n\nreturn [itemOut];"
      },
      "type": "n8n-nodes-base.code",
