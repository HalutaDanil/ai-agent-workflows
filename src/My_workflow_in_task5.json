    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\n\nif (!data.chatHistory) {\n  data.chatHistory = [];\n}\n\nconst messageText = $input.first().json.output\n\ndata.chatHistory.push({\n  role: \"ai\",\n  content: messageText,\n});\n\nreturn data.chatHistory"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
