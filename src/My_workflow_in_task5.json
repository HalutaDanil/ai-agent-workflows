      "id": "a18936a8-7461-4c2c-a41f-d9b8a52140d5",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.output;\nconst cleaned = text.replace('finalversion', '').trim();\nconst topicBlocks = cleaned.split('\\n\\n'); \nconst newItems = [];\n\nfor (let i = 0; i < topicBlocks.length; i++) {\n  const block = topicBlocks[i];\n  const lines = block.split('\\n'); \n\n  if (lines.length < 2) continue;\n\n  for (let j = 1; j < lines.length; j++) {\n    const line = lines[j].trim();\n  \n    if (line === '') continue;\n\n    newItems.push({\n      json: {\n        topic: line,\n      },\n    });\n  }\n}\n\nreturn newItems;\n"
      },
