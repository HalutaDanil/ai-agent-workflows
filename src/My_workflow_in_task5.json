    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\nconst newItems = [];\nconst tavilyPattern = /^tavily\\(query=\"(.+)\"\\)\\s*$/;\n\nfor (const item of inputItems) {\n  const text = item.json.output;\n  const match = text.match(tavilyPattern);\n  \n  if (match) {\n    newItems.push({\n      json: {\n        is_valid: true,\n        tavilyQuery: match[1], \n      },\n    });\n  } else {\n    newItems.push({\n      json: {\n        is_valid: false,\n        text: text,\n      },\n    });\n  }\n}\n\nreturn newItems;"
      },
